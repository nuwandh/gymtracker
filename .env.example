# Copy these into Vercel > Project Settings > Environment Variables (do not commit real values)
APP_PASSWORD=choose-a-long-passphrase
SHEET_ID=the-id-from-your-google-sheet-url
# Paste the whole service-account JSON key file (or its base64)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
